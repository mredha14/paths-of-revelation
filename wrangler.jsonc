{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paths-of-revelation",
  "keep_vars": true,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paths-of-revelation",
      "database_id": "87bd5b18-3717-435c-a507-461322e8cea2",
      "migrations_dir": "drizzle",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "paths-of-revelation-files",
      "remote": true
    }
  ]
}

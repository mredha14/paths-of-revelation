# Copy this file to .dev.vars for local development. Do not commit .dev.vars.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase Dashboard -> Project Settings -> API -> service_role
# This key stays server-side; never place it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated email addresses that may manage places and taxonomy.
ADMIN_EMAIL_ALLOWLIST=you@example.com
